{
  "name": "raftimpl",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node src/index.ts --id 1 --port 7001 --peers \"2:127.0.0.1:7002,3:127.0.0.1:7003\"",
    "node1": "ts-node src/index.ts --id 1 --port 7001 --peers \"2:127.0.0.1:7002,3:127.0.0.1:7003\"",
    "node2": "ts-node src/index.ts --id 2 --port 7002 --peers \"1:127.0.0.1:7001,3:127.0.0.1:7003\"",
    "node3": "ts-node src/index.ts --id 3 --port 7003 --peers \"1:127.0.0.1:7001,2:127.0.0.1:7002\"",
    "node4": "ts-node src/index.ts --id 4 --port 7004 --peers \"1:127.0.0.1:7001,2:127.0.0.1:7002,3:127.0.0.1:7003\"",
    "node5": "ts-node src/index.ts --id 5 --port 7005 --peers \"1:127.0.0.1:7001,2:127.0.0.1:7002,3:127.0.0.1:7003\"",
    "test:cluster": "concurrently \"npm run node1\" \"npm run node2\" \"npm run node3\" \"npm run node4\" \"npm run node5\"",
    "test:3node": "concurrently \"npm run node1\" \"npm run node2\" \"npm run node3\"",
    "test:5node": "concurrently \"npm run node1\" \"npm run node2\" \"npm run node3\" \"npm run node4\" \"npm run node5\"",
    "build": "tsc",
    "build:debug": "tsc --extendedDiagnostics",
    "start": "node dist/index.js",
    "start:1": "node dist/index.js --id 1 --port 7001 --peers \"2:127.0.0.1:7002,3:127.0.0.1:7003\"",
    "start:2": "node dist/index.js --id 2 --port 7002 --peers \"1:127.0.0.1:7001,3:127.0.0.1:7003\"",
    "start:3": "node dist/index.js --id 3 --port 7003 --peers \"1:127.0.0.1:7001,2:127.0.0.1:7002\"",
    "clean": "rm -rf dist && mkdir dist",
    "debug": "npm run clean && npm run build:debug && ls -la dist/ && echo \"=== Checking dist contents ===\" && find dist/ -type f -name \"*.js\" | head -10"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
